# Neon Postgres (Vercel Postgres)
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# Browserless.io - free tier: 1000 units/month
# Sign up at https://www.browserless.io/
BROWSERLESS_API_KEY=your_key_here

# Brevo email API
BREVO_API_KEY=your_brevo_key_here
FROM_EMAIL=alerts@yourdomain.com

# Secret token to protect the /api/check cron endpoint
CRON_SECRET=generate_a_random_string_here

# Your deployed URL
NEXT_PUBLIC_BASE_URL=https://your-app.vercel.app
